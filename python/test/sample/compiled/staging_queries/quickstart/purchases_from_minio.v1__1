  "query": "\nSELECT\n    user_id,\n    UNIX_TIMESTAMP(ts) * 1000 as ts,\n    purchase_price,\n    item_category as category,\n    DATE_FORMAT(ts, 'yyyy-MM-dd') as ds\nFROM parquet.`s3a://chronon/warehouse/data/purchases/purchases.parquet`\nWHERE purchase_price > 0\nORDER BY ts\n",
