    "name": "quickstart.users_from_minio.v1__None",
    "outputNamespace": "quickstart",
    "sourceFile": "staging_queries/quickstart/users_from_minio.py",
    "tableProperties": {
      "description": "Users data loaded from MinIO and transformed to Iceberg"
    },
    "team": "quickstart"
  },
  "query": "\nSELECT\n    user_id,\n    email,\n    email_verified,\n    account_created_ts,\n    age,\n    country,\n    ds\nFROM quickstart_users_external\nWHERE ds BETWEEN '{{ start_date }}' AND '{{ end_date }}'\n    AND age >= 18\nORDER BY ds, user_id\n",
  "setups": [
    "\n        CREATE EXTERNAL TABLE IF NOT EXISTS quickstart_users_external (\n            user_id STRING,\n            email STRING,\n            email_verified BOOLEAN,\n            account_created_ts BIGINT,\n            age INT,\n            country STRING,\n            ds STRING\n        )\n        STORED AS PARQUET\n        LOCATION 's3a://chronon/warehouse/data/users/'\n        "
  ],
  "startPartition": "2023-11-01"
}